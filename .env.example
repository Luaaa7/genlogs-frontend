# URL base del backend. Cada quien la puede sobreescribir localmente en un
# archivo .env.local (ignorado por git) si necesita apuntar a otro backend
# (por ejemplo, uno corriendo en su propia máquina).
#
# Copia este archivo a .env.local para empezar:
#   cp .env.example .env.local
VITE_API_URL=https://genlogs-backend-bkuv.onrender.com/api

# Interruptor de la vitrina (Fase 3). Apagado hasta pasar la prueba de 10 pedidos.
VITE_VITRINA_HABILITADA=false
